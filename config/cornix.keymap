/*
 * Cornix — Vial 配列からの移植
 * 元ファイル：vil/2026-09-09_cornix_vial.vil
 * 生成：scripts/vil2zmk.py（キー番号の対応は config/includes/cornix54.h の図を参照）
 * キー配置は .vil が元。変えた位置は vil2zmk.py の POS_OVERRIDE、コンボは COMBOS 表（.vil のコンボは使わない）
 * ZMK 側だけで足したもの：速度層 MSLOW（EXTRA_LAYER_*）、コンボの誤爆ガード（COMBO_PRIOR_IDLE_MS）
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define BASE 0
#define NUMPAD 1
#define SYM 2
#define MOUSE 3
#define RPAD 4
#define MSLOW 5
#define BTL 6

// マウスキー移動の速度切り替え：MSLOW 層が有効な間だけ移動量を縮める
// （マウス層の左親指 42 を押している間 = &mo MSLOW）
&mmv_input_listener {
    slow {  // 低速（精密）：1/3 倍
        layers = <MSLOW>;
        input-processors = <&zip_xy_scaler 1 3>;
    };
};

/ {
    behaviors {
        // 誤操作でPCとのペアリングを消さないよう、3秒長押しでだけ Clear BT
        bt_clr_hold: bt_clr_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&bt>, <&none>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
        };
        // 数・記号キー：外側が長押し判定、内側がタップダンス（2026-10-02 組み替え）
        //   長押し＝押している間 数・記号（別のキーを押した瞬間に確定）
        //   タップ＝次の1キーだけ 数・記号／2回タップ＝次の1キーだけ R pad
        sym_td: sym_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&sl SYM>, <&sl RPAD>;
        };
        sym_ht: sym_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sym_td>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // W+E → F24（W Up）
        combo_00 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <2 3>;
            bindings = <&kp F24>;
            layers = <BASE>;
        };
        // A+S → Esc。as はローマ字に多い（masu 等）ので必ずガード
        combo_01 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <13 14>;
            bindings = <&kp ESC>;
            layers = <BASE>;
        };
        // S+D → F23（W Dn）
        combo_02 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <14 15>;
            bindings = <&kp F23>;
            layers = <BASE>;
        };
        // D+F → 無変換。ローマ字の直後に押す。df はローマ字に出ない（誤爆ガードなし）
        combo_03 {
            timeout-ms = <40>;
            key-positions = <15 16>;
            bindings = <&kp INT_MUHENKAN>;
            layers = <BASE>;
        };
        // Z+X → Del
        combo_04 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <25 26>;
            bindings = <&kp DEL>;
            layers = <BASE>;
        };
        // X+C → BS。打ち間違いの直後に押す（誤爆ガードなし）
        combo_05 {
            timeout-ms = <40>;
            key-positions = <26 27>;
            bindings = <&kp BSPC>;
            layers = <BASE>;
        };
        // C+V → Enter。打ち終わった直後に確定（誤爆ガードなし）
        combo_06 {
            timeout-ms = <40>;
            key-positions = <27 28>;
            bindings = <&kp RET>;
            layers = <BASE>;
        };
        // X+C+V → Ctrl+Enter。誤爆すると送信してしまう
        combo_07 {
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
            key-positions = <26 27 28>;
            bindings = <&kp LC(RET)>;
            layers = <BASE>;
        };
        // S+D+F ／ 4+5+6 → Num pad 層 ON/OFF
        combo_08 {
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
            key-positions = <14 15 16>;
            bindings = <&tog NUMPAD>;
            layers = <BASE NUMPAD>;
        };
        // A+S+D+F ／ Left+Down+Up+Right → マウス層 ON/OFF
        combo_09 {
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
            key-positions = <13 14 15 16>;
            bindings = <&tog MOUSE>;
            layers = <BASE MOUSE MSLOW>;
        };
        // P+BS → Del
        combo_10 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <10 11>;
            bindings = <&kp DEL>;
            layers = <BASE>;
        };
        // I+O → [（JIS）
        combo_11 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <8 9>;
            bindings = <&kp RBKT>;
            layers = <BASE>;
        };
        // J+K → 変換。ローマ字の直後に押す。jk はローマ字に出ない（誤爆ガードなし）
        combo_12 {
            timeout-ms = <40>;
            key-positions = <19 20>;
            bindings = <&kp INT_HENKAN>;
            layers = <BASE>;
        };
        // K+L → ]（JIS）
        combo_13 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <20 21>;
            bindings = <&kp NON_US_HASH>;
            layers = <BASE>;
        };
        // ,+. → @（JIS）
        combo_14 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <34 35>;
            bindings = <&kp LBKT>;
            layers = <BASE NUMPAD SYM>;
        };
        // .+↑ → PgUp
        combo_15 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <35 36>;
            bindings = <&kp PG_UP>;
            layers = <BASE NUMPAD SYM>;
        };
        // ↑+/ → PgDn
        combo_16 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <36 37>;
            bindings = <&kp PG_DN>;
            layers = <BASE NUMPAD SYM>;
        };
        // ←+↓ → Home。矢印同士（誤爆ガードなし）
        combo_17 {
            timeout-ms = <40>;
            key-positions = <47 48>;
            bindings = <&kp HOME>;
            layers = <BASE NUMPAD SYM>;
        };
        // ↓+→ → End。矢印同士（誤爆ガードなし）
        combo_18 {
            timeout-ms = <40>;
            key-positions = <48 49>;
            bindings = <&kp END>;
            layers = <BASE NUMPAD SYM>;
        };
        // ,+1 → Del（誤爆ガードなし）
        combo_19 {
            timeout-ms = <40>;
            key-positions = <25 26>;
            bindings = <&kp DEL>;
            layers = <NUMPAD>;
        };
        // 1+2 → BS（誤爆ガードなし）
        combo_20 {
            timeout-ms = <40>;
            key-positions = <26 27>;
            bindings = <&kp BSPC>;
            layers = <NUMPAD>;
        };
        // 2+3 → Num Enter（誤爆ガードなし）
        combo_21 {
            timeout-ms = <40>;
            key-positions = <27 28>;
            bindings = <&kp KP_ENTER>;
            layers = <NUMPAD>;
        };
        // 1+2+3 → Ctrl+Enter（誤爆ガードなし）
        combo_22 {
            timeout-ms = <60>;
            key-positions = <26 27 28>;
            bindings = <&kp LC(RET)>;
            layers = <NUMPAD>;
        };
        // Click2+Click3 → F24（W Up）（誤爆ガードなし）
        combo_23 {
            timeout-ms = <40>;
            key-positions = <2 3>;
            bindings = <&kp F24>;
            layers = <MOUSE MSLOW>;
        };
        // Down+Up → F23（W Dn）（誤爆ガードなし）
        combo_24 {
            timeout-ms = <40>;
            key-positions = <14 15>;
            bindings = <&kp F23>;
            layers = <MOUSE MSLOW>;
        };
        // ←+↓ → Del（誤爆ガードなし）
        combo_25 {
            timeout-ms = <40>;
            key-positions = <25 26>;
            bindings = <&kp DEL>;
            layers = <MOUSE MSLOW>;
        };
        // ↓+↑ → BS（誤爆ガードなし）
        combo_26 {
            timeout-ms = <40>;
            key-positions = <26 27>;
            bindings = <&kp BSPC>;
            layers = <MOUSE MSLOW>;
        };
        // ↑+→ → Enter（誤爆ガードなし）
        combo_27 {
            timeout-ms = <40>;
            key-positions = <27 28>;
            bindings = <&kp RET>;
            layers = <MOUSE MSLOW>;
        };
        // ↓+↑+→ → Ctrl+Enter（誤爆ガードなし）
        combo_28 {
            timeout-ms = <60>;
            key-positions = <26 27 28>;
            bindings = <&kp LC(RET)>;
            layers = <MOUSE MSLOW>;
        };
        // P+O → [（JIS）
        combo_29 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <1 2>;
            bindings = <&kp RBKT>;
            layers = <RPAD>;
        };
        // -+L → ]（JIS）
        combo_30 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <13 14>;
            bindings = <&kp NON_US_HASH>;
            layers = <RPAD>;
        };
        // K+J → 変換（誤爆ガードなし）
        combo_31 {
            timeout-ms = <40>;
            key-positions = <15 16>;
            bindings = <&kp INT_HENKAN>;
            layers = <RPAD>;
        };
        // .+, → @（JIS）
        combo_32 {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <26 27>;
            bindings = <&kp LBKT>;
            layers = <RPAD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T                                        &kp Y          &kp U          &kp I          &kp O          &kp P          &kp BSPC
&kp LCTRL      &kp A          &kp S          &kp D          &kp F          &kp G                                        &kp H          &kp J          &kp K          &kp L          &kp MINUS      &kp RET
&kp LSHFT      &kp Z          &kp X          &kp C          &kp V          &kp B          &kp ESC        &kp RET        &kp N          &kp M          &kp COMMA      &kp DOT        &kp UP         &kp FSLH
&kp LGUI       &none          &mo BTL        &kp LALT       &sym_ht SYM 0  &kp SPACE                                    &kp RALT       &kp RCTRL      &kp RSHFT      &kp LEFT       &kp DOWN       &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp F22 F21 &inc_dec_kp F20 F19>;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&trans           &kp KP_DIVIDE    &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MINUS                                       &none            &none            &none            &none            &none            &trans
&trans           &kp KP_MULTIPLY  &kp KP_N4        &kp KP_N5        &kp KP_N6        &kp KP_PLUS                                        &none            &none            &none            &none            &none            &kp KP_ENTER
&trans           &kp COMMA        &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_DOT       &kp KP_NUMLOCK   &trans           &none            &none            &trans           &trans           &trans           &trans
&trans           &none            &none            &trans           &kp KP_N0        &trans                                             &trans           &trans           &trans           &trans           &trans           &trans
            >;
        };

        symbol_layer {
            display-name = "Symbol";
            bindings = <
&trans       &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                                 &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &trans
&trans       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0                                 &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &trans
&trans       &kp MINUS    &kp EQUAL    &kp SEMI     &kp SQT      &kp INT_RO   &trans       &trans       &kp F11      &kp F12      &trans       &trans       &trans       &trans
&trans       &kp LBKT     &kp INT_YEN  &trans       &kp LCTRL    &kp LSHFT                              &trans       &trans       &trans       &trans       &trans       &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans           &mkp MB4         &mkp MB2         &mkp MB3         &mkp MB1         &none                                              &none            &none            &none            &none            &none            &none
&trans           &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &none                                              &none            &none            &none            &none            &none            &none
&trans           &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &none            &none            &none            &none            &none            &none            &none            &none            &none
&trans           &none            &none            &trans           &mo MSLOW        &trans                                             &trans           &trans           &trans           &none            &none            &none
            >;
        };

        rpad_layer {
            display-name = "RPad";
            bindings = <
&trans      &kp P       &kp O       &kp I       &kp U       &kp Y                               &none       &none       &none       &none       &none       &none
&trans      &kp MINUS   &kp L       &kp K       &kp J       &kp H                               &none       &none       &none       &none       &none       &none
&trans      &kp FSLH    &kp DOT     &kp COMMA   &kp M       &kp N       &trans      &kp C_MUTE  &none       &none       &none       &none       &none       &none
&trans      &none       &none       &trans      &kp LCTRL   &kp LSHFT                           &none       &none       &none       &none       &none       &none
            >;
            sensor-bindings = <&inc_dec_kp F22 F21 &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mouseslow_layer {
            display-name = "MouseSlow";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &out OUT_TOG  &none  &bt_clr_hold BT_CLR_CMD 0
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
